# SkyMiles Travel OS — copy to .env.local and fill in.
# .env.local is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Supabase
# Project Settings -> API. Free tier is ample at ~100 customers / ~1000 a year.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security entirely — used for the Excel
# importer and scheduled jobs, never to render a page.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Portal database connection
#
# Connects as `portal_reader`, the role created in the layer 8 migration with
# NO grants on any base table — it can only read the portal_* views, which
# physically lack supplier, cost and margin columns. This is what makes the
# privacy guarantee real rather than a coding convention.
#
# The migration creates the role NOLOGIN because a migration must not contain a
# password. Run this once against your project, then paste the result here:
#
#   alter role portal_reader with login password '<generate a strong one>';
#
# Do NOT put sslmode in this URL — TLS is configured in code. Recent pg versions
# read sslmode=require as full chain verification, which fails against
# Supabase's per-project self-signed CA.
#
#   postgresql://portal_reader:<password>@db.<ref>.supabase.co:5432/postgres
# ---------------------------------------------------------------------------
PORTAL_DATABASE_URL=

# Supabase's Postgres CA certificate, PEM contents on one line.
# Dashboard -> Settings -> Database -> SSL Configuration -> download.
# When set, the portal connection verifies the certificate chain. When empty the
# connection is still encrypted but the chain is unverified — set this before
# the system carries live customer data.
PORTAL_DB_CA_CERT=

# Superuser connection, used only by the Supabase CLI for migrations and by
# scripts/verify-remote.mjs. Percent-encode special characters in the password
# ($ -> %24, % -> %25, ) -> %29, @ -> %40).
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Phase 2+ — not needed to run the CRM
# ---------------------------------------------------------------------------

# Signing secret for public quotation links (/q/[token]).
QUOTE_LINK_SECRET=

# Transactional email (quote sent, trip confirmed, balance reminders).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Phase 5 — Razorpay payment links
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# No WhatsApp API keys. Nothing in this system sends WhatsApp messages — the
# "Copy message" button writes to the clipboard for manual pasting.
# ---------------------------------------------------------------------------
